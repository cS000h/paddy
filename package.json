{
  "name": "dao",
  "private": true,
  "version": "0.1.0",
  "description": "《稻》：中式田园像素生活 RPG（开发中）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "vite build && vite preview --open",
    "test": "node tools/test.mjs --tag fast",
    "test:all": "node tools/test.mjs",
    "test:browser": "node tools/test.mjs --level L5",
    "test:list": "node tools/test.mjs --list",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "art:sheet": "node tools/art-sheet.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "playwright-core": "^1.50.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.8"
  }
}
